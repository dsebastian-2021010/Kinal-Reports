{
  "name": "kinal-reports-services",
  "version": "1.0.0",
  "description": "Shared dependencies for all Kinal Reports microservices",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "fastify": "^5.7.4",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.2.4",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  },
  "scripts": {
    "dev": "concurrently \"npm run gateway\" \"npm run chat\" \"npm run documents\" \"npm run schedule\" \"npm run sections\" \"npm run events\" \"npm run notifications\" \"npm run teacher-status\" \"npm run reports\" \"npm run users\"",
    "chat": "cd chat-service && npm run dev",
    "documents": "cd documents-service && npm run dev",
    "schedule": "cd schedule-service && npm run dev",
    "sections": "cd sections-service && npm run dev",
    "events": "cd events-service && npm run dev",
    "notifications": "cd notifications-service && npm run dev",
    "teacher-status": "cd teacher-status-service && npm run dev",
    "reports": "cd reports-service && npm run dev",
    "users": "cd users-service && npm run dev"
  }
}
